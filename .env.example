# ---- Meridian Signal ----
# Copy to .env and fill in. NEVER commit .env with real values.

# --- OpenAI (digest) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx        # server-side only, bypasses RLS

# --- Sources ---
SIGNAL_FEED_URL=https://raw.githubusercontent.com/augusto-hjs/meridian-signal/main/sources/feed.json
